{
  "name": "hayatan",
  "version": "7.1.1",
  "description": "Hayatan - Torrent streaming made simple",
  "main": "./out/main/index.js",
  "repository": "github:BerlinPCS/electron",
  "author": "ThaUnknown_",
  "homepage": "https://github.com/BerlinPCS/electron",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "lint": "eslint --cache .",
    "test:sidecar": "node --experimental-transform-types --test test/*.test.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false --noEmit",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:sidecar": "node scripts/build-hoshidicts.mjs && node scripts/prepare-ffmpeg.mjs",
    "build:ffmpeg:source": "sh native/ffmpeg-build/build.sh",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.mjs",
    "start": "electron-vite preview",
    "dev": "npm run build:sidecar && electron-vite dev --watch",
    "rebuild": "electron-rebuild -f -w yencode",
    "build": "npm run build:sidecar && electron-vite build",
    "build:publish": "npm run build && electron-builder -p always",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/fuses": "^2.1.1",
    "@paymoapp/electron-shutdown-handler": "^1.1.3",
    "@types/node": "^25.9.3",
    "@xhayper/discord-rpc": "^1.3.4",
    "abslink": "^1.2.2",
    "bittorrent-tracker": "^11.2.3",
    "cookie": "^1.1.1",
    "electron": "42.2.0",
    "electron-builder": "^26.11.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "eslint-config-standard-universal": "^1.0.10",
    "native": "github:hayase-app/native",
    "rollup-plugin-license": "^3.7.1",
    "torrent-client": "github:hayase-app/torrent-client#98a32231d2453be0293ca3b581860aead469e509",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vite-plugin-cjs-interop": "^2.4.4",
    "zip-go": "^1.1.1"
  },
  "pnpm": {
    "overrides": {
      "@vladfrangu/async_event_emitter": "npm:@vladfrangu/async_event_emitter@2.4.6",
      "@thaunknown/simple-peer@10.1.1": "file:npm-package-cache/thaunknown-simple-peer-10.1.1.tgz",
      "@thaunknown/simple-peer@10.1.2": "file:npm-package-cache/thaunknown-simple-peer-10.1.2.tgz",
      "@thaunknown/simple-websocket@9.1.4": "file:npm-package-cache/thaunknown-simple-websocket-9.1.4.tgz",
      "@thaunknown/thirty-two@1.0.6": "file:npm-package-cache/thaunknown-thirty-two-1.0.6.tgz",
      "@thaunknown/yencode@1.5.5": "file:npm-package-cache/thaunknown-yencode-1.5.5.tgz",
      "abslink@1.2.2": "file:npm-package-cache/abslink-1.2.2.tgz",
      "block-iterator@1.1.2": "file:npm-package-cache/block-iterator-1.1.2.tgz",
      "chunk-store-iterator@1.0.4": "file:npm-package-cache/chunk-store-iterator-1.0.4.tgz",
      "cross-fetch-ponyfill@1.0.3": "file:npm-package-cache/cross-fetch-ponyfill-1.0.3.tgz",
      "fast-readable-async-iterator@1.1.2": "file:npm-package-cache/fast-readable-async-iterator-1.1.2.tgz",
      "fast-readable-async-iterator@2.0.0": "file:npm-package-cache/fast-readable-async-iterator-2.0.0.tgz",
      "fsa-chunk-store@1.3.0": "file:npm-package-cache/fsa-chunk-store-1.3.0.tgz",
      "join-async-iterator@1.1.1": "file:npm-package-cache/join-async-iterator-1.1.1.tgz",
      "nntp-js@1.0.5": "file:npm-package-cache/nntp-js-1.0.5.tgz",
      "nzb-file@1.1.18": "file:npm-package-cache/nzb-file-1.1.18.tgz",
      "nzb-parser@1.0.4": "file:npm-package-cache/nzb-parser-1.0.4.tgz",
      "throughput@1.0.2": "file:npm-package-cache/throughput-1.0.2.tgz",
      "torrent-client>ebml-iterator": "-",
      "torrent-client>ebml-stream": "-",
      "torrent-client>matroska-metadata": "-",
      "uint8-util@2.3.2": "file:npm-package-cache/uint8-util-2.3.2.tgz",
      "webrtc-polyfill@1.2.2": "file:npm-package-cache/webrtc-polyfill-1.2.2.tgz"
    },
    "packageExtensions": {
      "torrent-client@1.0.0": {
        "dependencies": {
          "fast-readable-async-iterator": "^1.1.2"
        }
      }
    }
  },
  "dependencies": {
    "music-metadata": "^11.14.0"
  }
}
